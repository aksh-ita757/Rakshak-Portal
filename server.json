// Create FIR
app.post('/api/firs', authenticateToken, async (req, res) => {
  const connection = await pool.getConnection();
  
  try {
    await connection.beginTransaction();

    const {
      complainantName,
      mobile,
      email,
      address,
      crimeType,
      details,
      incidentDate,
      location
    } = req.body;

    // Generate FIR number
    const [lastFir] = await connection.query(
      'SELECT fir_number FROM firs ORDER BY id DESC LIMIT 1'
    );
    
    let firNumber = 'FIR1001';
    if (lastFir.length > 0) {
      const lastNum = parseInt(lastFir[0].fir_number.replace('FIR', ''));
      firNumber = `FIR${lastNum + 1}`;
    }

    // Insert FIR
    const [result] = await connection.query(
      `INSERT INTO firs (fir_number, user_id, complainant_name, mobile, email, 
       address, crime_type, incident_details, incident_date, location, status) 
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Pending')`,
      [firNumber, req.user.id, complainantName, mobile, email, address, 
       crimeType, details, incidentDate, location]
    );

    // Create notification for user
    await connection.query(
      'INSERT INTO notifications (user_id, type, message) VALUES (?, ?, ?)',
      [req.user.id, 'FIR_SUBMITTED', `Your FIR ${firNumber} has been submitted successfully`]
    );

    // Notify all officers
    await connection.query(
      `INSERT INTO notifications (user_id, type, message)
       SELECT id, 'NEW_FIR', ? FROM users WHERE role IN ('admin', 'officer')`,
      [`New FIR ${firNumber} submitted - ${crimeType}`]
    );

    // Audit log
    await connection.query(
      'INSERT INTO audit_logs (user_id, action, details) VALUES (?, ?, ?)',
      [req.user.id, 'FIR_CREATED', `FIR ${firNumber} created for ${crimeType}`]
    );

    await connection.commit();

    res.status(201).json({
      success: true,
      message: 'FIR submitted successfully',
      data: {
        firNumber,
        firId: result.insertId,
        status: 'Pending'
      }
    });

  } catch (error) {
    await connection.rollback();
    console.error('Create FIR error:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Failed to submit FIR' 
    });
  } finally {
    connection.release();
  }
});

// Get All FIRs (with filters)
app.get('/api/firs', authenticateToken, async (req, res) => {
  try {
    const { status, crimeType, search, page = 1, limit = 20 } = req.query;
    
    let query = 'SELECT * FROM firs WHERE 1=1';
    const params = [];

    // Role-based filtering
    if (req.user.role === 'citizen') {
      query += ' AND user_id = ?';
      params.push(req.user.id);
    }

    // Apply filters
    if (status) {
      query += ' AND status = ?';
      params.push(status);
    }

    if (crimeType) {
      query += ' AND crime_type = ?';
      params.push(crimeType);
    }

    if (search) {
      query += ' AND (fir_number LIKE ? OR complainant_name LIKE ? OR location LIKE ?)';
      const searchPattern = `%${search}%`;
      params.push(searchPattern, searchPattern, searchPattern);
    }

    // Get total count
    const countQuery = query.replace('SELECT *', 'SELECT COUNT(*) as total');
    const [countResult] = await pool.query(countQuery, params);
    const total = countResult[0].total;

    // Add pagination
    const offset = (parseInt(page) - 1) * parseInt(limit);
    query += ' ORDER BY created_at DESC LIMIT ? OFFSET ?';
    params.push(parseInt(limit), offset);

    // Execute query
    const [firs] = await pool.query(query, params);

    res.json({
      success: true,
      data: firs,
      pagination: {
        currentPage: parseInt(page),
        totalPages: Math.ceil(total / limit),
        totalRecords: total,
        recordsPerPage: parseInt(limit)
      }
    });

  } catch (error) {
    console.error('Get FIRs error:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Failed to fetch FIRs' 
    });
  }
});

// Get Single FIR
app.get('/api/firs/:id', authenticateToken, async (req, res) => {
  try {
    const { id } = req.params;

    const [firs] = await pool.query(
      'SELECT * FROM firs WHERE id = ? OR fir_number = ?',
      [id, id]
    );

    if (firs.length === 0) {
      return res.status(404).json({ 
        success: false, 
        error: 'FIR not found' 
      });
    }

    const fir = firs[0];

    // Check permissions
    if (req.user.role === 'citizen' && fir.user_id !== req.user.id) {
      return res.status(403).json({ 
        success: false, 
        error: 'Access denied' 
      });
    }

    res.json({ 
      success: true, 
      data: fir 
    });

  } catch (error) {
    console.error('Get FIR error:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Failed to fetch FIR' 
    });
  }
});

// Update FIR Status (Admin/Officer only)
app.patch('/api/firs/:id', authenticateToken, authorizeRoles('admin', 'officer'), async (req, res) => {
  const connection = await pool.getConnection();
  
  try {
    await connection.beginTransaction();

    const { id } = req.params;
    const { status, notes, assignedOfficer } = req.body;

    // Get FIR details
    const [firs] = await connection.query(
      'SELECT * FROM firs WHERE id = ? OR fir_number = ?',
      [id, id]
    );

    if (firs.length === 0) {
      await connection.rollback();
      return res.status(404).json({ 
        success: false, 
        error: 'FIR not found' 
      });
    }

    const fir = firs[0];

    // Update FIR
    await connection.query(
      'UPDATE firs SET status = ?, notes = ?, assigned_officer = ?, updated_at = NOW() WHERE id = ?',
      [status, notes, assignedOfficer, fir.id]
    );

    // Create case update
    await connection.query(
      'INSERT INTO case_updates (fir_id, updated_by, update_type, description) VALUES (?, ?, ?, ?)',
      [fir.id, req.user.id, 'STATUS_CHANGE', `Status changed to ${status}`]
    );

    // Notify user
    await connection.query(
      'INSERT INTO notifications (user_id, type, message) VALUES (?, ?, ?)',
      [fir.user_id, 'FIR_UPDATED', `Your FIR ${fir.fir_number} status has been updated to: ${status}`]
    );

    // Audit log
    await connection.query(
      'INSERT INTO audit_logs (user_id, action, details) VALUES (?, ?, ?)',
      [req.user.id, 'FIR_UPDATED', `FIR ${fir.fir_number} updated to ${status}`]
    );

    await connection.commit();

    res.json({ 
      success: true, 
      message: 'FIR updated successfully' 
    });

  } catch (error) {
    await connection.rollback();
    console.error('Update FIR error:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Failed to update FIR' 
    });
  } finally {
    connection.release();
  }
});

