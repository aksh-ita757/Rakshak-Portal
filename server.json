// TRACKING
// ============================================

app.get('/api/track/:referenceNumber', async (req, res) => {
  try {
    const { referenceNumber } = req.params;
    const ref = referenceNumber.toUpperCase();

    // Search in FIRs
    const [firs] = await pool.query(
      'SELECT * FROM firs WHERE fir_number = ?',
      [ref]
    );

    if (firs.length > 0) {
      return res.json({
        success: true,
        type: 'FIR',
        data: firs[0]
      });
    }

    // Search in Complaints
    const [complaints] = await pool.query(
      'SELECT * FROM complaints WHERE complaint_number = ?',
      [ref]
    );

    if (complaints.length > 0) {
      return res.json({
        success: true,
        type: 'COMPLAINT',
        data: complaints[0]
      });
    }

    res.status(404).json({
      success: false,
      error: 'No record found with this reference number'
    });

  } catch (error) {
    console.error('Track error:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Failed to track status' 
    });
  }
});

