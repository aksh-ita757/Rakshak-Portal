        pendingComplaints: complaintStats.pending || 0,
        emergencyAlerts: emergencyStats.total || 0
      }
    });

  } catch (error) {
    console.error('Dashboard stats error:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Failed to fetch stats' 
    });
  }
});

