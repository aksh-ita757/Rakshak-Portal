// Create Complaint
app.post('/api/complaints', authenticateToken, async (req, res) => {
  const connection = await pool.getConnection();
  
  try {
    await connection.beginTransaction();

    const { name, contact, type, details } = req.body;

    // Generate complaint number
    const [lastComplaint] = await connection.query(
      'SELECT complaint_number FROM complaints ORDER BY id DESC LIMIT 1'
    );
    
    let complaintNumber = 'CMP2001';
    if (lastComplaint.length > 0) {
      const lastNum = parseInt(lastComplaint[0].complaint_number.replace('CMP', ''));
      complaintNumber = `CMP${lastNum + 1}`;
    }

    // Insert complaint
    const [result] = await connection.query(
      `INSERT INTO complaints (complaint_number, user_id, complainant_name, contact, 
       complaint_type, details, status) VALUES (?, ?, ?, ?, ?, ?, 'Pending')`,
      [complaintNumber, req.user.id, name, contact, type, details]
    );

    // Create notification
    await connection.query(
      'INSERT INTO notifications (user_id, type, message) VALUES (?, ?, ?)',
      [req.user.id, 'COMPLAINT_SUBMITTED', `Your complaint ${complaintNumber} has been submitted`]
    );

    // Audit log
    await connection.query(
      'INSERT INTO audit_logs (user_id, action, details) VALUES (?, ?, ?)',
      [req.user.id, 'COMPLAINT_CREATED', `Complaint ${complaintNumber} created`]
    );

    await connection.commit();

    res.status(201).json({
      success: true,
      message: 'Complaint submitted successfully',
      data: {
        complaintNumber,
        complaintId: result.insertId
      }
    });

  } catch (error) {
    await connection.rollback();
    console.error('Create complaint error:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Failed to submit complaint' 
    });
  } finally {
    connection.release();
  }
});

